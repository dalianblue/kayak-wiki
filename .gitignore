# 大文件铁律(1016宕机复盘): 二进制/大文件一律不进git
raw/assets/*
!raw/assets/.gitkeep
*.pdf
*.PDF
*.epub
*.webp
*.jpg
*.jpeg
*.png
*.mp4
__pycache__/
.venv/
*.pyc
.DS_Store
# 公开层小资产例外(资产纪律: 资产是内容, 必须进git; ≤500KB)
!site-demo/docs/assets/*.jpg
!site-demo/docs/assets/*.webp
site-demo/site/
site-demo/.venv/

# 第三方授权素材: 凭证与照片不进git(RIGHTS.yaml为唯一台账)
raw/photos/
raw/rights/
# 转载书图片(WebP压缩版, 12MB, 服务器侧保留; CI构建无需图片)
site-demo/docs/build/handbuild/img/
